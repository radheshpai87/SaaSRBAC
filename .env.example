# Environment Configuration for SaaS RBAC

# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54320/saas_rbac?sslmode=disable"
PG_PORT="54320"

# Auth.js / NextAuth configuration
AUTH_SECRET="change-this-to-a-secure-random-secret-in-production"
NEXTAUTH_SECRET="change-this-to-a-secure-random-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Seed bootstrap credentials (used during initial database setup only)
SEED_DEFAULT_PASSWORD="YourInitialSecurePassword123!"
